# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local env and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
secrets/**

# Runtime and generated state
node_modules/
**/node_modules/
.cache/
dist/
build/
out/
coverage/
*.log
logs/

# Python/local tooling caches
__pycache__/
**/__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Samostatné private gbrain data repo se mountuje jako nested checkout.
# Super-repo ho nikdy netrackuje jako gitlink ani běžný adresář.
gbrain/

# Private secret-free profil Buddyho (<login>/<login>-buddy) je také nested
# checkout. Bootstrap ho nevytváří, ale Personalspace s Buddym ho nesmí omylem
# trackovat.
buddy/

# Soukromé osobní moduly jsou Doctor-managed nested checkouty.
workspace/*
!workspace/.gitkeep

# Task worktree tohoto repa patří vedle něj do personalspace/.worktrees/<task>.
# Kdyby přece vznikl uvnitř, Git ho netrackuje.
.worktrees/

# Editor state
.idea/
.cursor/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
